<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.moringa.class_schedule_app">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".ui.main.HomeActivity"></activity>
        <activity android:name=".ui.main.AccountTypeActivity" />
        <activity android:name=".ui.main.TmSignUpActivity" />
        <activity
            android:name=".ui.MainActivity" />
        <activity
            android:name=".ui.main.StudentSignUpActivity"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />
        <activity
            android:name=".ui.main.LoginActivity"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.Post" />
        <activity android:name=".ui.Search" />
        <activity
            android:name=".ui.Main"
            android:label="@string/title_activity_main" />
    </application>

</manifest>