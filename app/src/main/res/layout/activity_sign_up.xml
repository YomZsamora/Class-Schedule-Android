<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pimg"
    tools:context=".ui.SignUp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_above="@id/sign_holder"
        android:padding="10dp">

        <TextView
            android:layout_centerVertical="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30dp"
            android:layout_marginLeft="10dp"
            android:textColor="@android:color/white"
            android:text="Create student account"/>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/sign_holder"
        android:layout_centerInParent="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"

        >
        <EditText
            android:id="@+id/sign_name"
            android:inputType="text"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:backgroundTint="#242424"
            android:background="@drawable/input_light_curved"
            app:elevation="8dp"
            android:textColor="@android:color/white"
            android:textColorHint="@android:color/white"
            android:paddingStart="18dp"
            android:paddingLeft="18dp"
            android:textSize="17sp"
            android:layout_marginBottom="10dp"
            android:hint="name"/>

        <EditText
            android:id="@+id/sign_email"
            android:inputType="textEmailAddress"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:textColor="@android:color/white"
            android:backgroundTint="#242424"
            android:background="@drawable/input_light_curved"
            app:elevation="8dp"
            android:textColorHint="@android:color/white"
            android:paddingStart="18dp"
            android:paddingLeft="18dp"
            android:textSize="17sp"
            android:layout_marginBottom="10dp"
            android:hint="email"/>

        <EditText
            android:id="@+id/sign_cohort"
            android:inputType="text"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:textColor="@android:color/white"
            android:backgroundTint="#242424"
            android:background="@drawable/input_light_curved"
            app:elevation="8dp"
            android:textColorHint="@android:color/white"
            android:paddingStart="18dp"
            android:paddingLeft="18dp"
            android:textSize="17sp"
            android:drawableRight="@drawable/ic_keyboard_arrow_down_black_24dp"
            android:drawableTint="#fff"
            android:paddingRight="15dp"
            android:layout_marginBottom="10dp"
            android:hint="cohort / class"/>

        <EditText
            android:id="@+id/sign_password"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:textColor="@android:color/white"
            android:backgroundTint="#242424"
            android:background="@drawable/input_light_curved"
            app:elevation="8dp"
            android:textColorHint="@android:color/white"
            android:paddingStart="18dp"
            android:paddingLeft="18dp"
            android:textSize="17sp"
            android:layout_marginBottom="10dp"
            android:hint="password"/>

        <EditText
            android:id="@+id/confirm_password"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:textColor="@android:color/white"
            android:backgroundTint="#242424"
            android:background="@drawable/input_light_curved"
            app:elevation="8dp"
            android:textColorHint="@android:color/white"
            android:paddingStart="18dp"
            android:paddingLeft="18dp"
            android:textSize="17sp"
            android:layout_marginBottom="10dp"
            android:hint="Confrim password"/>

        <Button
            android:id="@+id/signup_btn"
            android:textAllCaps="false"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Sign up"
            android:textColor="#fff"
            android:textSize="18sp"
            android:background="@drawable/outline_curved"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/sign_holder"
        android:paddingHorizontal="15dp"
        android:gravity="center">
        <TextView
            android:id="@+id/toLoginTextView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#fff"
            android:text="Already have an account? "
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/toLoginTextView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#fff"
            android:text="Log in"
            android:textSize="14sp"/>

    </LinearLayout>
</RelativeLayout>