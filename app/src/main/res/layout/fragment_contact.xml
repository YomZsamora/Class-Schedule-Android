<?xml version="1.0" encoding="utf-8"?>
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="fill_parent"
        android:background="@color/colorSecondaryLight"
        android:layout_height="wrap_content"
        android:fillViewport="true" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dip" >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/muli_bold"
                android:textColor="@color/colorPrimaryLight"
                android:gravity="center_vertical"
                android:textSize="18sp"
                android:text="Students" />

            <ImageView
                android:layout_width="50dp"
                android:layout_height="2dp"
                android:src="@drawable/title_underline"/>

            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/contactProgressBar"/>

            <TextView
                android:visibility="gone"
                android:id="@+id/studentListError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/errorLightRed"
                android:text="Error"
                android:gravity="center"/>

            <ListView
                android:id="@+id/studentsContactList"
                android:visibility="gone"
                android:scrollbarThumbVertical="@color/colorPrimaryLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:divider="@color/colorPrimaryLight"
                android:background="@color/colorSecondaryLight" >
            </ListView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/muli_bold"
                android:textColor="@color/colorPrimaryLight"
                android:gravity="center_vertical"
                android:textSize="18sp"
                android:text="Technical Mentors" />

            <ImageView
                android:layout_width="50dp"
                android:layout_height="2dp"
                android:src="@drawable/title_underline"/>

            <TextView
                android:visibility="gone"
                android:id="@+id/tmListError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/errorLightRed"
                android:text="Error"
                android:gravity="center"/>

            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/contactProgressBar2"/>
            <ListView
                android:visibility="gone"
                android:scrollbarThumbVertical="@color/colorPrimaryLight"
                android:divider="@color/colorPrimaryLight"
                android:id="@+id/tmContactsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:background="@color/colorSecondaryLight" >
            </ListView>
        </LinearLayout>

    </ScrollView>

