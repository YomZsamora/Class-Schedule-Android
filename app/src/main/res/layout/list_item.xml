<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:elevation="0dp"
    android:padding="5dp"
    android:background="@drawable/rounded_corners"
    android:backgroundTint="@color/white"
    app:elevation="0dp"
    android:layout_marginBottom="5dp"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/hrz"
        android:paddingBottom="5dp"
        android:background="@drawable/rounded_corners"
        android:backgroundTint="@color/light_blue"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">

    <LinearLayout
        android:layout_centerVertical="true"
        android:id="@+id/linear"
        android:layout_gravity="start"
        android:layout_alignParentTop="true"
        android:layout_marginStart="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/avTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Update"
            android:textSize="20sp"
            android:textColor="@color/white"
            />
        <TextView
            android:id="@+id/avtm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="technical mentor"
            android:textColor="@color/cream"
            android:textSize="14sp"/>

    </LinearLayout>

        <ImageButton
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentRight="true"
            android:layout_gravity="end"
            android:layout_marginRight="5dp"
            android:backgroundTint="@android:color/transparent"
            android:src="@drawable/ic_baseline_add_circle_24"
            android:tint="@color/white" />
    </RelativeLayout>

    <TextView
        android:layout_below="@id/hrz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/avtime"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="5dp"
        android:text="start:10.00pm - 12.00pm fri, 26, 2020"
        android:paddingBottom="0dp"
        android:textSize="13sp"/>
    <TextView
        android:layout_below="@id/avtime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="5dp"
        android:paddingBottom="15dp"
        android:textSize="15sp"
        android:text="description"
        android:textColor="@color/textgreylight"
        android:id="@+id/avdesc"/>


</RelativeLayout>